#!/usr/bin/env python3
import os
import sys
from pathlib import Path

venv = Path(__file__).resolve().parent / ".venv"
interpreter = venv / "bin/python"
if interpreter.is_file() and os.access(interpreter, os.X_OK) and Path(sys.prefix).resolve() != venv.resolve():
    os.execv(interpreter, [str(interpreter), __file__, *sys.argv[1:]])

from session_ref.cli import main

if __name__ == "__main__":
    sys.exit(main())
